# Copy to .env.local and set only the services you are actively testing.
# Never commit real values. Keep credentials on the server, not NEXT_PUBLIC_*.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

ANS_API_KEY=
ANS_BASE_URL=

MAPBOX_TOKEN=

TELEGRAM_BOT_TOKEN=
# Comma-separated private chat IDs that have started this bot and opted in.
TELEGRAM_ALLOWED_CHAT_IDS=
# Keep routine demos simulated; use telegram only with approved contacts.
BEACON_NOTIFICATION_MODE=simulated

DEMO_MODE=true

# Explicit activation only after Google account/billing approval. Server-only key.
BEACON_GOOGLE_ROUTES_ENABLED=false
GOOGLE_ROUTES_API_KEY=
# Legacy BEACON_WALKING_ROUTER=google_routes remains supported if the flag above is absent.

# Private model worker: managed Codex login stays on the operator's laptop.
BEACON_PLANNER_MODE=
BEACON_PLANNER_WORKER_TOKEN=
BEACON_CONTEXT_AGENT_URL=
BEACON_CONTEXT_SERVICE_TOKEN=
BEACON_PROVIDER_TOKEN=
BEACON_HOSTED_PROVIDERS=false
BEACON_PROVIDER_ORIGIN=
BEACON_HOSTED_PROVIDER_TOKEN=
BEACON_MONITOR_TOKEN=
# Synthetic campus pickup permission for local demo providers only, never live access evidence.
BEACON_SYNTHETIC_JOURNEY_BINDINGS=false
# Complete labeled campus scenario and operator-controlled simulated ride progress.
# Enable together only for demonstrations. The normal data path remains available.
BEACON_DEMO_SCENARIO=false
BEACON_DEMO_SCENARIO_VARIANT=baseline
BEACON_DEMO_RIDE_PROGRESS=false

# Real Uber Guest Rides SANDBOX transport only; all rides/payments are simulated.
# Requires approved guests.trips scope, active run and verified test guest.
# Keep disabled until access is verified. A client secret alone is insufficient.
UBER_GUEST_SANDBOX_ENABLED=false
UBER_GUEST_ACCESS_TOKEN=
UBER_GUEST_ORGANIZATION_ID=
UBER_GUEST_RUN_ID=
UBER_GUEST_ID=
UBER_GUEST_PRODUCT_ID=
