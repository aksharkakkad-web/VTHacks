# Copy values into your local shell or .env.local; never commit credentials.
# Prefer OAuth: databricks auth login --host <workspace-url> --profile <your-name>
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CONFIG_PROFILE=
# A short-lived OAuth token is injected in memory by run.mjs when a profile is set.
# Hosted environments may supply their approved server-side OAuth access token.
DATABRICKS_TOKEN=
# An existing catalog you can use. Setup creates only its Beacon schema/tables.
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=beacon
# Set after setup; three-part names, no SQL expressions.
DATABRICKS_ROUTE_CONTEXT_TABLE=workspace.beacon.route_context
DATABRICKS_AUDIT_TABLE=workspace.beacon.decision_events
DATABRICKS_TRANSIT_TABLE=workspace.beacon.transit_departures
